--- a/fastvideo/models/wan/transformer.py
+++ b/fastvideo/models/wan/transformer.py
@@ -796,6 +796,9 @@ class WanTransformer3DModel(BaseDiT):
                                             compute_dtype=torch.float32)
         self.proj_out = nn.Linear(inner_dim, config.out_channels * math.prod(config.patch_size))
         self.scale_shift_table = nn.Parameter(torch.randn(1, 2, inner_dim) / inner_dim**0.5)
