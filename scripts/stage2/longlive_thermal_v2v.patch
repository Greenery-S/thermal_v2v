+    @torch.no_grad()
+    def _compact_kv_cache_for_grad_region(self):
+        """thermal-v2v: long rollouts (num_training_frames > local window) evict KV entries block by block. Under
+        gradient checkpointing the backward recomputes each gradient-enabled block against the cache as it is at
+        backward time, so an eviction inside the gradient region makes the recomputed attention window differ from
+        the forward one (CheckpointError, or silently wrong grads). Upstream sizes the cache as local_attn_size +
+        slice_last_frames for exactly this, but never frees that room. Before the first gradient-enabled block, keep
+        only [sink | last (local_attn_size - sink) frames], moved to the front, so the gradient region fits without
+        eviction. The attended window is unchanged: it was those frames anyway."""
+        if self.local_attn_size == -1 or self.kv_cache1 is None:
+            return
+        fsl = self.frame_seq_length
+        keep = self.local_attn_size * fsl
+        sink = max(int(self.sink_size or 0), int(self.global_sink_size or 0)) * fsl
+        for c in self.kv_cache1:
+            end = int(c["local_end_index"].item())
+            if end <= keep:
+                continue
+            for name in ("k", "v"):
+                t = c[name]
+                tail = t[:, end - (keep - sink):end].clone()
+                t[:, sink:keep] = tail
+            c["local_end_index"].fill_(keep)
+
