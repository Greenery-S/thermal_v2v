+++ b/LongLive2.0/thermal_eval.py
@@ -0,0 +1,115 @@
+"""thermal-v2v: streaming RGB->thermal evaluation of a LongLive causal checkpoint on precomputed val latents.
+
+Each val file (thermal_v2v/src/precompute_latents.py) holds RAW Wan2.2 latents `cond` (RGB) and `target` (thermal)
+[48, f, h, w]. The RGB stream is clamped into the even frames of every 2-frame chunk; the generated odd frames are
+the thermal output. Writes per-clip mp4 (RGB | ours | GT), metrics.json with affine-aligned PSNR/SSIM on the
+decoded thermal (vs the VAE-decoded GT latent).
+
+  LLV2_PROMPT_EMBEDS=<prompt_embeds.pt> python thermal_eval.py --config configs/thermal/infer_ar_r2t.yaml \
+      --latents <val dir> --out <dir> [--ckpt <logdir>/checkpoint_model_XXXXXX/model.pt --use_ema] [--n 8]
+Without --ckpt the converted bidirectional ICL teacher runs causally with no AR training (baseline).
+"""
+import argparse
+import glob
+import json
+import os
+import time
+
+import imageio
+import numpy as np
+import torch
+from omegaconf import OmegaConf
+from safetensors.torch import load_file
+
+from pipeline import CausalDiffusionInferencePipeline
+from utils.config import normalize_config
+from utils.nvfp4_checkpoint import clean_fsdp_state_dict_keys, unwrap_generator_state_dict
+from utils.thermal_dataset import WAN22_MEAN, WAN22_STD
+from utils.wan_5b_wrapper import build_text_encoder
+
+
+def affine_metrics(pred, gt):
+    """pred, gt: [F, H, W] in [-1, 1]; fit gt ~ a*pred + b over the clip, then PSNR / mean SSIM."""
+    from skimage.metrics import structural_similarity
+    p, g = pred.reshape(-1).astype(np.float64), gt.reshape(-1).astype(np.float64)
+    A = np.stack([p, np.ones_like(p)], 1)
+    a, b = np.linalg.lstsq(A, g, rcond=None)[0]
+    pa = np.clip(a * pred + b, -1, 1)
+    mse = np.mean((pa - gt) ** 2)
+    psnr = 10 * np.log10(4.0 / max(mse, 1e-10))
+    ssim = float(np.mean([structural_similarity(pa[i], gt[i], data_range=2.0) for i in range(len(gt))]))
+    return float(psnr), ssim
+
+
+def to_u8(x):  # [F, 3, H, W] in [-1, 1]
+    return ((x.clamp(-1, 1) + 1) * 127.5).round().byte().permute(0, 2, 3, 1).cpu().numpy()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--latents", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--ckpt", default=None)
+    ap.add_argument("--use_ema", action="store_true")
+    ap.add_argument("--n", type=int, default=8)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--fps", type=int, default=10)
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    cfg = normalize_config(OmegaConf.load(a.config))
+    device = torch.device("cuda")
+    torch.set_grad_enabled(False)
+
+    pipe = CausalDiffusionInferencePipeline(cfg, device=device, text_encoder=build_text_encoder())
+    if a.ckpt:
+        sd = unwrap_generator_state_dict(torch.load(a.ckpt, map_location="cpu"), use_ema=a.use_ema)
+        sd = clean_fsdp_state_dict_keys(sd)
+        missing, unexpected = pipe.generator.load_state_dict(sd, strict=False)
+        print(f"loaded {a.ckpt} ema={a.use_ema} missing={len(missing)} unexpected={len(unexpected)}", flush=True)
+        if missing:
+            raise RuntimeError(f"missing keys: {missing[:8]}")
+    pipe = pipe.to(device=device, dtype=torch.bfloat16)
+    pipe.vae = pipe.vae.to(device=device, dtype=torch.bfloat16)
+
+    mean = torch.tensor(WAN22_MEAN).view(1, 48, 1, 1, 1)
+    std = torch.tensor(WAN22_STD).view(1, 48, 1, 1, 1)
+    f_lat = int(cfg.image_or_video_shape[1]) // 2
+    files = sorted(glob.glob(os.path.join(a.latents, "**", "*.safetensors"), recursive=True))[: a.n]
+    prompt = getattr(cfg, "thermal_prompt", "transfer rgb to thermal")
+    rows = []
+    for fi, path in enumerate(files):
+        d = load_file(path)
+        cond = ((d["cond"].float()[None, :, :f_lat] - mean) / std)  # [1, 48, f, h, w]
+        tgt = ((d["target"].float()[None, :, :f_lat] - mean) / std)
+        cond_bf = cond.permute(0, 2, 1, 3, 4).to(device, torch.bfloat16)  # [1, f, 48, h, w]
+        gen = torch.Generator(device="cpu").manual_seed(a.seed + fi)
+        noise = torch.randn((1, 2 * f_lat, 48, cond.shape[-2], cond.shape[-1]), generator=gen).to(device, torch.bfloat16)
+        num_blocks = (2 * f_lat) // pipe.num_frame_per_block
+        t0 = time.time()
+        lat = pipe.inference(noise=noise, text_prompts=[[prompt] * num_blocks], return_latents=True,
+                             cond_latents=cond_bf)
+        lat = lat[1] if isinstance(lat, tuple) else lat
+        torch.cuda.synchronize()
+        sec = time.time() - t0
+        thermal_lat = lat[:, 1::2].to(torch.bfloat16)  # [1, f, 48, h, w]
+        pred = pipe.vae.decode_to_pixel(thermal_lat)[0].float()  # [F, 3, H, W]
+        gt = pipe.vae.decode_to_pixel(tgt.permute(0, 2, 1, 3, 4).to(device, torch.bfloat16))[0].float()
+        rgb = pipe.vae.decode_to_pixel(cond_bf)[0].float()
+        pg, gg = pred.mean(1).cpu().numpy(), gt.mean(1).cpu().numpy()
+        psnr, ssim = affine_metrics(pg, gg)
+        name = os.path.splitext(os.path.basename(path))[0]
+        frames = np.concatenate([to_u8(rgb), to_u8(pred.mean(1, keepdim=True).repeat(1, 3, 1, 1)),
+                                 to_u8(gt.mean(1, keepdim=True).repeat(1, 3, 1, 1))], axis=2)
+        imageio.mimsave(os.path.join(a.out, f"{name}.mp4"), list(frames), fps=a.fps, quality=8, macro_block_size=1)
+        rows.append({"name": name, "psnr_affine": psnr, "ssim_affine": ssim, "sample_sec": sec,
+                     "video_frames": int(pred.shape[0])})
+        print(json.dumps(rows[-1]), flush=True)
+    summ = {k: float(np.mean([r[k] for r in rows])) for k in ("psnr_affine", "ssim_affine", "sample_sec")}
+    json.dump({"ckpt": a.ckpt, "use_ema": a.use_ema, "config": a.config, "summary": summ, "per_clip": rows},
+              open(os.path.join(a.out, "metrics.json"), "w"), indent=1)
+    print("SUMMARY", json.dumps(summ), flush=True)
+
+
+if __name__ == "__main__":
+    main()
-- 
