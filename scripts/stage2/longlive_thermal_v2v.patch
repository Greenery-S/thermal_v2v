diff --git a/LongLive2.0/utils/thermal_dataset.py b/LongLive2.0/utils/thermal_dataset.py
new file mode 100644
index 0000000..f7b14f0
--- /dev/null
+++ b/LongLive2.0/utils/thermal_dataset.py
@@ -0,0 +1,66 @@
+"""thermal-v2v: precomputed paired RGB / thermal latents, interleaved for LongLive AR teacher forcing.
+
+Each file under `latent_dir` is a safetensors written by thermal_v2v/src/precompute_latents.py with
+`cond` (RGB-in-thermal) and `target` (thermal16, clip-normalised) RAW Wan2.2 VAE latents of shape [48, f, h, w].
+They are normalised with the Wan2.2 VAE mean/std (the same convention as WanVAEWrapper.encode_to_latent and our
+ICL teacher) and interleaved along time as [RGB_0, T_0, RGB_1, T_1, ...] -> [2*f, 48, h, w].
+
+Batch layout matches the trainer's precomputed-latent path: {"prompts": [[prompt]], "ode_latent": [B, 1, 2f, C, H, W]}.
+"""
+import glob
+import os
+import random
+
+import torch
+from safetensors.torch import load_file
+from torch.utils.data import Dataset
+
+WAN22_MEAN = [-0.2289, -0.0052, -0.1323, -0.2339, -0.2799, 0.0174, 0.1838, 0.1557, -0.1382, 0.0542, 0.2813, 0.0891,
+              0.1570, -0.0098, 0.0375, -0.1825, -0.2246, -0.1207, -0.0698, 0.5109, 0.2665, -0.2108, -0.2158, 0.2502,
+              -0.2055, -0.0322, 0.1109, 0.1567, -0.0729, 0.0899, -0.2799, -0.1230, -0.0313, -0.1649, 0.0117, 0.0723,
+              -0.2839, -0.2083, -0.0520, 0.3748, 0.0152, 0.1957, 0.1433, -0.2944, 0.3573, -0.0548, -0.1681, -0.0667]
+WAN22_STD = [0.4765, 1.0364, 0.4514, 1.1677, 0.5313, 0.4990, 0.4818, 0.5013, 0.8158, 1.0344, 0.5894, 1.0901, 0.6885,
+             0.6165, 0.8454, 0.4978, 0.5759, 0.3523, 0.7135, 0.6804, 0.5833, 1.4146, 0.8986, 0.5659, 0.7069, 0.5338,
+             0.4889, 0.4917, 0.4069, 0.4999, 0.6866, 0.4093, 0.5709, 0.6065, 0.6415, 0.4944, 0.5726, 1.2042, 0.5458,
+             1.6887, 0.3971, 1.0600, 0.3943, 0.5537, 0.5444, 0.4089, 0.7468, 0.7744]
+
+
+class InterleavedThermalLatents(Dataset):
+    def __init__(self, latent_dir: str, num_latent_frames: int, prompt: str = "transfer rgb to thermal",
+                 random_crop_time: bool = True):
+        self.files = sorted(glob.glob(os.path.join(latent_dir, "**", "*.safetensors"), recursive=True))
+        if not self.files:
+            raise FileNotFoundError(f"no .safetensors latents under {latent_dir}")
+        self.f = int(num_latent_frames)
+        self.prompt = prompt
+        self.random_crop_time = random_crop_time
+        self.mean = torch.tensor(WAN22_MEAN).view(48, 1, 1, 1)
+        self.std = torch.tensor(WAN22_STD).view(48, 1, 1, 1)
+
+    def __len__(self):
+        return len(self.files)
+
+    def __getitem__(self, idx):
+        d = load_file(self.files[idx])
+        cond, tgt = d["cond"].float(), d["target"].float()  # [48, f, h, w]
+        if cond.shape != tgt.shape:
+            raise ValueError(f"{self.files[idx]}: cond {tuple(cond.shape)} != target {tuple(tgt.shape)}")
+        n = cond.shape[1]
+        if n < self.f:
+            raise ValueError(f"{self.files[idx]} has {n} latent frames < {self.f}")
+        # latent 0 of a Wan2.2 clip is the single-frame causal latent; only crop at 0 to keep that structure
+        s = 0
+        cond, tgt = cond[:, s:s + self.f], tgt[:, s:s + self.f]
+        cond = (cond - self.mean) / self.std
+        tgt = (tgt - self.mean) / self.std
+        x = torch.stack([cond, tgt], dim=2).flatten(1, 2)  # [48, 2f, h, w], frame order RGB_0, T_0, RGB_1, ...
+        x = x.permute(1, 0, 2, 3).contiguous()  # [2f, 48, h, w]
+        return {"prompts": [self.prompt], "ode_latent": x.unsqueeze(0), "file": os.path.basename(self.files[idx])}
+
+
+def thermal_collate(items):
+    return {
+        "prompts": [it["prompts"] for it in items],
+        "ode_latent": torch.stack([it["ode_latent"] for it in items]),
+        "file": [it["file"] for it in items],
+    }
diff --git a/LongLive2.0/utils/wan_5b_wrapper.py b/LongLive2.0/utils/wan_5b_wrapper.py
index 4884cb5..d9983c6 100644
--- a/LongLive2.0/utils/wan_5b_wrapper.py
+++ b/LongLive2.0/utils/wan_5b_wrapper.py
@@ -55,6 +55,35 @@ class WanTextEncoder(torch.nn.Module):
         }
 
 
+class CachedTextEncoder(torch.nn.Module):
+    """thermal-v2v: serve precomputed UMT5 embeddings for a fixed prompt set instead of loading the 11 GB T5.
+
+    The cache is a dict {prompt: [512, 4096] tensor} with zeroed padding (same layout WanTextEncoder returns).
+    Enabled by LLV2_PROMPT_EMBEDS=<path to .pt>. Unknown prompts raise, so a typo cannot silently train on zeros.
+    """
+    is_cached = True
+
+    def __init__(self, path: str) -> None:
+        super().__init__()
+        self.table = {k: v.float() for k, v in torch.load(path, map_location="cpu").items()}
+
+    @property
+    def device(self):
+        return torch.cuda.current_device()
+
+    def forward(self, text_prompts: List[str]) -> dict:
