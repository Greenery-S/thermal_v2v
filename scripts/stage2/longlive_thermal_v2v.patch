+model_kwargs:
+  model_name: Wan2.2-TI2V-5B
+  timestep_shift: 5.0
+  num_frame_per_block: 2
+  local_attn_size: -1
+  interleave_cond: true
+
+real_model_kwargs:
+  model_name: Wan2.2-TI2V-5B
+  timestep_shift: 5.0
+  num_frame_per_block: 42
+  local_attn_size: -1
+  interleave_cond: true
+
+fake_model_kwargs:
+  model_name: Wan2.2-TI2V-5B
+  timestep_shift: 5.0
+  num_frame_per_block: 42
+  local_attn_size: -1
+  interleave_cond: true
+
+checkpoints:
+  generator_ckpt: /hpctmp/yky/thermal_v2v/runs/ll_ar_r2t_v1/snapshots/step_001500.pt
+  generator_lora_init: /hpctmp/yky/thermal_v2v/models/longlive_plug/LongLive-Plug-Wan2.2-TI2V-5B-few-step/adapter_model.safetensors
+
+algorithm:
+  trainer: score_distillation
+  distribution_loss: dmd
+  i2v: false
+  all_causal: true
+  generator_is_causal: true
+  backward_simulation: true
+  teacher_forcing: false
+  independent_first_frame: false
+  ts_schedule: false
+  real_guidance_scale: 1.0
+  fake_guidance_scale: 0.0
+  interleave_cond: true
+
+training:
+  lr: 1.0e-05
+  lr_critic: 2.0e-06
+  weight_decay: 0.0
+  beta1: 0.0
+  beta2: 0.999
+  beta1_critic: 0.0
+  beta2_critic: 0.999
+  batch_size: 1
+  gradient_accumulation_steps: 1
+  ema_weight: 0.0
+  ema_start_step: 100000
+  log_iters: 100
+  max_checkpoints: 3
+  max_iters: 2
+  gc_interval: 100
+  dfake_gen_update_ratio: 5
+  min_num_training_frames: 42
+  num_training_frames: 42
+  slice_last_frames: 42
+
+data:
+  data_path: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/train
+  eval_data_path: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/val
+  thermal_latent_dir: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/train
+  thermal_prompt: transfer rgb to thermal
+  image_or_video_shape:
+  - 1
+  - 42
+  - 48
+  - 32
+  - 40
+  load_raw_video: false
+
+inference:
+  sampling_steps: 4
+  sink_size: 0
+  local_attn_size: 42
+  independent_first_frame: false
+  negative_prompt: ''
+
+evaluation:
+  interval: 0
+
+adapter:
+  type: lora
+  rank: 128
+  alpha: 128
+  dropout: 0.0
+  apply_to_critic: true
+
+logging:
+  seed: 0
+  wandb_project: thermal-v2v-dmd
