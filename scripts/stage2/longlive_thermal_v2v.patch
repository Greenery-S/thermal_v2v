 from utils.distributed import EMA_FSDP, fsdp_wrap, launch_distributed_job
+
+
+class LoraEMA:
+    """thermal-v2v: fp32 EMA of the trainable (LoRA) generator weights, keyed like peft's LoRA state dict."""
+
+    def __init__(self, root, decay, resume=None):
+        # root = the FSDP-wrapped generator (summoned so root-owned LoRA params are full on every rank);
+        # parameters are walked on root.model, the peft model, so keys match get_peft_model_state_dict
+        self.decay = decay
+        self.shadow = {}
+        with torch.no_grad(), FSDP.summon_full_params(root, writeback=False):
+            for n, p in root.model.named_parameters():
+                if p.requires_grad:
+                    k = self._key(n)
+                    src = resume[k] if resume is not None and k in resume else p.detach()
+                    self.shadow[k] = src.to(device=p.device, dtype=torch.float32).clone()
+
+    @staticmethod
+    def _key(n):
+        n = n.replace("_fsdp_wrapped_module.", "").replace("_checkpoint_wrapped_module.", "").replace("_orig_mod.", "")
