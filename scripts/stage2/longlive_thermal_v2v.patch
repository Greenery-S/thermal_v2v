 1 file changed, 6 insertions(+)

diff --git a/LongLive2.0/pipeline/self_forcing_training.py b/LongLive2.0/pipeline/self_forcing_training.py
index 3478b34..266ba3a 100644
--- a/LongLive2.0/pipeline/self_forcing_training.py
+++ b/LongLive2.0/pipeline/self_forcing_training.py
@@ -338,6 +338,12 @@ class SelfForcingTrainingPipeline:
 
     def _restore_attn_overrides(self, prev):
         """Restore model attention state saved by _apply_attn_overrides."""
+        # thermal-v2v: keep the rollout's attention settings. The generator's gradient-checkpointed blocks are
+        # recomputed during backward, AFTER the rollout returns; restoring here (to the model's init default, which
+        # is local_attn_size * 880 tokens, sized for Wan-1.3B frames) made the recomputed attention window wider
+        # than the forward one (CheckpointError with local windows; silently different attention otherwise).
+        # The generator is only ever run through these rollouts during training, so nothing needs the old values.
+        return
         model = self.generator.model
         model.local_attn_size = prev["local_attn_size"]
         model.rope_temporal_offset = prev["rope_temporal_offset"]
