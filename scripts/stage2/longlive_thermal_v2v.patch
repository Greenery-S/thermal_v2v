@@ -0,0 +1,88 @@
+# thermal-v2v: causal AR teacher-forcing SFT of our RGB->thermal ICL teacher on LongLive 2.0.
+# Interleaved latent frames [RGB_0, T_0, RGB_1, T_1, ...]; one block = (RGB_i, T_i) = 4 video frames.
+# Init: wan_models/Wan2.2-TI2V-5B -> our converted teacher (scripts/longlive/convert_teacher_to_wan.py).
+# Run from LongLive2.0/ with LLV2_PROMPT_EMBEDS set (cached UMT5 embeddings; no T5 load).
+infra:
+  sequence_parallel_size: 1
+  sharding_strategy: full
+  mixed_precision: true
+  gradient_checkpointing: true
+  generator_fsdp_wrap_strategy: size
+  text_encoder_fsdp_wrap_strategy: size
+
+model_kwargs:
+  model_name: Wan2.2-TI2V-5B
+  timestep_shift: 5.0
+  num_frame_per_block: 2
+  local_attn_size: -1
+  interleave_cond: true
+
+algorithm:
+  trainer: diffusion
+  i2v: false
+  causal: true
+  teacher_forcing: true
+  independent_first_frame: false
+  num_train_timestep: 1000
+  denoising_loss_type: flow
+  interleave_cond: true
+
+training:
+  lr: 1.0e-05
+  weight_decay: 0.0
+  beta1: 0.0
+  beta2: 0.999
+  batch_size: 1
+  gradient_accumulation_steps: 1
+  ema_weight: 0.99
+  ema_start_step: 100
+  log_iters: 1000
+  max_checkpoints: 3
+  max_iters: 3
+  gc_interval: 100
+  error_recycling:
+    enabled: true
+    num_buckets: 50
+    buffer_size_per_bucket: 100
+    buffer_warmup_iter: 50
+    context_inject_prob: 0.9
+    latent_inject_prob: 0.9
+    noise_inject_prob: 0.01
+    clean_prob: 0.2
+    clean_buffer_update_prob: 0.1
+    modulate_factor: 0.3
+    start_step: 0
+    replacement_strategy: random
+
+data:
+  data_path: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/train
+  eval_data_path: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/val
+  thermal_latent_dir: /hpctmp/yky/thermal_v2v/data/processed/tartanrgbt/latents_81f_s40/train
+  thermal_prompt: transfer rgb to thermal
+  # 81 video frames -> 21 latent frames per stream -> 42 interleaved frames at 32x40
+  image_or_video_shape:
+  - 1
+  - 42
+  - 48
+  - 32
+  - 40
+  load_raw_video: false
+
+inference:
+  sampling_steps: 50
+  sink_size: 0
+  guidance_scale: 1.0
+  independent_first_frame: false
+  negative_prompt: ''
+
+evaluation:
+  interval: 0
+  num_frames: 42
+  use_ema: true
+  val_batch_size: 1
+
+logging:
+  seed: 0
+  wandb_key: null
+  wandb_entity: null
+  wandb_project: thermal-v2v-ar
