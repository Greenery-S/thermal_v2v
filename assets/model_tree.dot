digraph G {
  rankdir=TB; nodesep=0.5; ranksep=0.55; bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge [color="#555555", arrowsize=0.8];
  D   [label="Paired RGB / thermal data\nTartanRGBT + KAIST + LLVIP", fillcolor="#e3f2fd", color="#1565c0"];
  B   [label="Stage 1: bidirectional teacher, multi-step\n(one LoRA, 33 frames)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  T2R [label="① bidirectional multi-step\nthermal → RGB", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  R2T [label="② bidirectional multi-step\nRGB → thermal", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  FS  [label="③ bidirectional 3-step RGB → thermal\n(stage 1b, FastVideo DMD)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  AR  [label="④ streaming AR multi-step RGB → thermal\n(stage 2, LongLive teacher forcing)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  SF  [label="⑤ streaming AR 4-step RGB → thermal\nself-forcing DMD within one attention window\nin progress: prototype trained", fillcolor="#fff3e0", color="#ef6c00", style="rounded,filled,dashed", penwidth=2];
  LR  [label="⑥ streaming AR 4-step RGB → thermal, long video\nlong-rollout tuning: student rolls out far past the attention window,\nteacher scores only the last window\nin progress: training started", fillcolor="#fff3e0", color="#ef6c00", style="rounded,filled,dashed", penwidth=2];
  D -> B; B -> T2R; B -> R2T; R2T -> FS; R2T -> AR;
  AR -> SF [style=dashed]; SF -> LR [style=dashed];
  subgraph cluster_legend { label=""; color="white";
    L1 [label="included in this repo (smoke-tested)", fillcolor="#d4f4dd", color="#2e7d32", fontsize=10];
    L2 [label="in progress on our side", fillcolor="#fff3e0", color="#ef6c00", style="rounded,filled,dashed", fontsize=10];
    L1 -> L2 [style=invis]; }
}
