digraph G {
  rankdir=TB; nodesep=0.45; ranksep=0.5; bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.16,0.08"];
  edge [color="#555555", arrowsize=0.8];
  S0  [label="S0  setup (once)\nscripts/setup/create_envs.sh\nscripts/stage1b/setup_fastvideo.sh\nscripts/stage2/setup_longlive.sh", fillcolor="#eeeeee", color="#777777"];
  D   [label="Paired RGB / thermal data: TartanRGBT + KAIST + LLVIP\nS1  download: scripts/data/download_{tartanrgbt.py, kaist.sh, llvip.sh}\nS2  smoke test, per stage right before its real run: scripts/smoke_test.sh\nS3  encode latents: scripts/data/encode_all.sh  (+ check_latents.py)", fillcolor="#e3f2fd", color="#1565c0"];
  B   [label="S4  stage 1: ONE training run → one LoRA checkpoint serving ① and ②\nbidirectional teacher, multi-step, 33 frames\nscripts/stage1/train.sh   (config: configs/stage1/bidir_33f.yaml)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  T2R [label="① bidirectional multi-step  thermal → RGB\n= the S4 checkpoint (no extra training)\neval: scripts/stage1/eval.sh <ckpt> thermal2rgb", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  R2T [label="② bidirectional multi-step  RGB → thermal\n= the same S4 checkpoint (no extra training)\neval: scripts/stage1/eval.sh <ckpt> rgb2thermal", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  FS  [label="③ bidirectional 3-step  RGB → thermal\nS5  stage 1b (FastVideo DMD):\nscripts/stage1b/merge_teacher.py → latents_to_parquet.py\n→ train_dmd.sh → eval.sh", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  AR  [label="④ streaming AR multi-step  RGB → thermal\nS6  stage 2 (LongLive teacher forcing):\nscripts/stage2/export_teacher.py → train_ar.sh → eval_ar.sh", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  SF  [label="⑤ streaming AR 4-step  RGB → thermal\nS7  self-forcing DMD (fresh LoRA on ④):\nscripts/stage3/train_dmd.sh → eval.sh\n(recipe validated on a 1-GPU prototype)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  LR  [label="⑥ streaming AR 4-step  RGB → thermal, long video\nS8  long-rollout tuning of the S7 LoRA:\nstudent rolls out far past the window, teacher scores the last window\nscripts/stage3/train_long.sh → eval.sh … long\ndefault S8b: + GT regression (keeps the tone; S8a = plain DMD)\n(prototype: 4-min stream pearson 0.72 → 0.90)", fillcolor="#d4f4dd", color="#2e7d32", penwidth=2];
  S0 -> D [style=dotted]; D -> B; B -> T2R; B -> R2T; R2T -> FS; R2T -> AR;
  AR -> SF; SF -> LR;
}
